+
+// Stores big-endian register values into the register file, returning whether any of them changed. No branches in the
+// loop, so it vectorizes like memory::copy_and_swap.
+bool StoreSwappedRegisters(uint32_t* __restrict dest, const uint32_t* __restrict src, uint32_t count) {
+  uint32_t difference = 0;
+  for (uint32_t i = 0; i < count; ++i) {
+    uint32_t value = rex::byte_swap(src[i]);
+    difference |= dest[i] ^ value;
+    dest[i] = value;
+  }
+  return difference != 0;
 }
 
 }  // namespace
