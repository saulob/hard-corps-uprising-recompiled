+REXCVAR_DEFINE_BOOL(gpu_skip_unchanged_constant_writes, true, "GPU",
+                    "Keep the uploaded constant buffers, texture bindings and sampler state when the "
+                    "game rewrites float, bool, loop or fetch constants with the values they have")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
